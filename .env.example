# Configure a personal McDonald's MCP token in the server environment.
# Keep this file empty of real credentials. Never use a NEXT_PUBLIC_ variable.
MCD_MCP_TOKEN=

# Local development only. Hosted deployments must keep authentication enabled.
# Set to 1 only in a local environment when explicitly testing the local API.
MCD_ALLOW_LOCAL=0

# Hosted Sites only: enable only behind the Sites gateway that supplies
# authenticated identity. Leave disabled on standalone/public servers.
MCD_TRUST_SITES_IDENTITY=0
# Required when enabling trusted Sites identity; only this user may access
# the deployment owner's McDonald's account. Never put an actual ID here.
MCD_OWNER_USER_ID=
