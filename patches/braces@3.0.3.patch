diff --git a/lib/safe-depth.js b/lib/safe-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..f0e613e23792dd41be30e57b137c120287d12f1e
--- /dev/null
+++ b/lib/safe-depth.js
@@ -0,0 +1,27 @@
+'use strict';
+
+// Local mitigation for CVE-2026-93687 until an upstream release is available.
+// Inspect children iteratively before any recursive AST walker is entered.
+const MAX_DEPTH = 128;
+const fail = () => {
+  const error = new RangeError('Brace nesting exceeds the safe depth limit (128)');
+  error.code = 'ERR_BRACES_DEPTH';
+  throw error;
+};
+
+const assertSafeDepth = ast => {
+  const pending = [[ast, 0]];
+  const seen = new WeakSet();
+  let count = 0;
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (node === null || typeof node !== 'object') continue;
+    if (depth > MAX_DEPTH || seen.has(node) || ++count > 100000) fail();
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
+
+module.exports = { MAX_DEPTH, fail, assertSafeDepth };
