{
  "name": "mai-just-right",
  "version": "1.0.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "demo": "node scripts/mai-cli.mjs demo",
    "receipt": "node scripts/mai-cli.mjs receipt",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-project.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "mcp:check": "node scripts/mai-cli.mjs mcp-check",
    "mcp:quote": "node scripts/mai-cli.mjs mcp-quote",
    "mcp:call": "node scripts/mai-cli.mjs mcp-call"
  },
  "dependencies": {
    "lucide-react": "^1.56.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "ws": "8.21.0",
    "undici": "7.29.1",
    "esbuild": "0.28.1",
    "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0",
    "image-size": "2.0.3",
    "fast-uri": "3.1.8"
  },
  "packageManager": "pnpm@11.25.0",
  "description": "Intent-first meal and coupon decisions with McDonald’s China MCP"
}
